# Modèle SANS SECRET. Copier en android/keystore.properties (ignoré par Git) puis remplir
# sur le poste qui signe. Ne jamais versionner la copie remplie ni la clé elle-même.
#
# storeFile est relatif au dossier android/ ; signing/ est ignoré par Git.
storeFile=signing/upload-keystore.jks
keyAlias=upload
storePassword=
keyPassword=
